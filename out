#elif defined(__x86_64__)
    return "x86_64";
#elif defined(__arm__)
    return "arm";
#elif defined(__aarch64__)
    return "aarch64";
#elif defined(__riscv)
    return "riscv-V";
#elif defined(__powerpc__)
    return "powerpc";
#else
    return "unknown";
#endif
}
